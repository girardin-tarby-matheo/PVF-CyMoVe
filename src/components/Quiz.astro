<!-- QUIZ CARD -->
<div
    id="quiz-container"
    class="relative w-full max-w-[680px] min-h-auto mx-auto mt-0 py-[30px] px-[35px] bg-[linear-gradient(345.37deg,rgba(255,255,255,0.63)-38.59%,#107AA5_138.59%)] shadow-[0px_18px_48px_rgba(6,27,43,0.086),inset_0px_1px_0px_rgba(255,255,255,0.86)] rounded-[24px] overflow-hidden [@media(max-width:840px)]:py-[20px] [@media(max-width:840px)]:px-[20px]"
>
    <div class="flex justify-between items-center w-full mb-4">
        <span
            class="font-black text-[24px] leading-[28px] text-[rgba(16,122,165,0.46)]"
            >Quiz</span
        >
        <span
            id="quiz-progress"
            class="font-black text-[24px] leading-[28px] text-[rgba(16,122,165,0.46)]"
        ></span>
    </div>

    <h3
        id="quiz-question"
        class="w-full font-bold text-[clamp(18px,2.2vw,24px)] leading-[1.3] text-white mb-6"
    >
    </h3>

    <div id="quiz-options" class="flex flex-col gap-3 w-full items-center">
    </div>

    <div
        id="quiz-feedback"
        class="hidden mt-5 rounded-2xl bg-white/80 px-4 py-3 text-center text-[#107AA5]"
        role="status"
        aria-live="polite"
    >
    </div>
</div>

<script>
    const quizData = [
        {
            question:
                "Quel est le coût approximatif du matériel nécessaire pour réaliser cette attaque ?",
            options: [
                "60 euros",
                "600 euros",
                "6 000 euros",
                "60 000 euros",
            ],
            answer: 1,
        },
        {
            question:
                "Quelle était la faiblesse principale du chiffrement utilisé par la clé Tesla à l'époque ?",
            options: [
                "Un chiffrement de seulement 40 bits",
                "Une absence totale de chiffrement",
                "Un mot de passe par défaut très simple",
                "Une connexion filaire obligatoire",
            ],
            answer: 0,
        },
        {
            question:
                "Quelle solution Tesla a-t-elle principalement proposée pour renforcer la sécurité au démarrage ?",
            options: [
                "L'obligation d'utiliser une clé USB",
                "L'option « PIN to Drive » (code secret)",
                "La suppression définitive des clés sans contact",
                "Le remplacement obligatoire de la voiture",
            ],
            answer: 1,
        },
        {
            question:
                "Que démontre principalement cet événement sur le plan de la cybersécurité ?",
            options: [
                "Que seules les voitures anciennes peuvent être piratées",
                "Qu'aucune marque n'est à l'abri d'un composant vulnérable",
                "Que les pirates ont obligatoirement besoin de supercalculateurs",
                "Que les clés connectées sont infaillibles",
            ],
            answer: 1,
        },
    ];

    let currentQuestion = 0;
    let score = 0;
    const answers: number[] = [];

    const questionEl = document.getElementById("quiz-question");
    const optionsEl = document.getElementById("quiz-options");
    const progressEl = document.getElementById("quiz-progress");
    const feedbackEl = document.getElementById("quiz-feedback");

    function loadQuestion() {
        if (!questionEl || !optionsEl || !progressEl || !feedbackEl) return;
        const q = quizData[currentQuestion];

        questionEl.textContent = q.question;
        progressEl.textContent = `${currentQuestion + 1} / ${quizData.length}`;

        optionsEl.innerHTML = "";
        feedbackEl.className = "hidden";
        feedbackEl.innerHTML = "";

        q.options.forEach((opt, index) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = `quiz-option flex flex-row justify-center items-center py-2.5 px-4 gap-[10px] w-full max-w-[540px] min-h-[50px] bg-[rgba(255,255,255,0.25)] shadow-[0px_12px_30px_rgba(6,27,43,0.08),inset_0px_1px_0px_rgba(255,255,255,0.86)] rounded-[20px] border-2 border-transparent font-sans font-normal text-[17px] leading-snug text-[#107AA5] cursor-pointer transition-all duration-200 hover:bg-[rgba(255,255,255,0.45)] hover:-translate-y-0.5`;
            btn.textContent = opt;
            btn.onclick = () => selectAnswer(index);
            optionsEl.appendChild(btn);
        });
    }

    function selectAnswer(index: number) {
        if (!optionsEl || !feedbackEl) return;
        const question = quizData[currentQuestion];
        const isCorrect = index === question.answer;
        answers[currentQuestion] = index;
        if (isCorrect) score++;

        const optionButtons = Array.from(
            optionsEl.querySelectorAll<HTMLButtonElement>(".quiz-option"),
        );
        optionButtons.forEach((button, optionIndex) => {
            button.disabled = true;
            button.classList.remove(
                "hover:bg-[rgba(255,255,255,0.45)]",
                "hover:-translate-y-0.5",
            );
            if (optionIndex === question.answer) {
                button.classList.add(
                    "!border-emerald-500",
                    "!bg-emerald-100",
                    "!text-emerald-800",
                );
            } else if (optionIndex === index) {
                button.classList.add(
                    "!border-rose-500",
                    "!bg-rose-100",
                    "!text-rose-800",
                );
            }
        });

        feedbackEl.className = `mt-5 rounded-2xl bg-white/85 px-4 py-3 text-center ${isCorrect ? "text-emerald-700" : "text-rose-700"}`;
        feedbackEl.innerHTML = `
            <p class="m-0 text-lg font-extrabold">${isCorrect ? "Bonne réponse !" : "Dommage !"}</p>
            <p class="mt-1 mb-3 text-sm text-slate-700">La bonne réponse était : <strong>${question.options[question.answer]}</strong></p>
            <button type="button" id="quiz-next" class="rounded-full bg-[#107AA5] px-5 py-2 text-sm font-bold text-white transition hover:bg-[#0b5e80]">
                ${currentQuestion + 1 < quizData.length ? "Question suivante" : "Voir mon résultat"}
            </button>
        `;
        document.getElementById("quiz-next")?.addEventListener("click", () => {
            currentQuestion++;
            if (currentQuestion < quizData.length) loadQuestion();
            else showResults();
        });
    }

    function showResults() {
        if (!questionEl || !optionsEl || !progressEl || !feedbackEl) return;
        questionEl.textContent = "Votre résultat";
        progressEl.textContent = `${score} / ${quizData.length}`;
        optionsEl.innerHTML = "";

        const encouragement =
            score === quizData.length
                ? "Félicitations ! Vous avez compris les différents points d’accès de l’attaque."
                : score >= 2
                  ? "Bien joué ! Vous avez identifié une grande partie des situations à risque."
                  : "Dommage ! Relisez les réponses pour retenir les différents points d’accès.";

        const result = document.createElement("div");
        result.className = "w-full text-center text-[#107AA5]";
        result.innerHTML = `
            <p class="m-0 text-2xl font-extrabold">${score} bonne${score > 1 ? "s" : ""} réponse${score > 1 ? "s" : ""} sur ${quizData.length}</p>
            <p class="mt-2 mb-5 text-lg font-bold">${encouragement}</p>
            <div class="space-y-2 text-left">
                ${quizData
                    .map((question, questionIndex) => {
                        const isCorrect =
                            answers[questionIndex] === question.answer;
                        return `<div class="rounded-xl border-2 ${isCorrect ? "border-emerald-300 bg-emerald-50" : "border-rose-300 bg-rose-50"} px-3 py-2 text-sm text-slate-700">
                        <strong>${isCorrect ? "✓" : "✗"} Question ${questionIndex + 1}</strong> · Bonne réponse : ${question.options[question.answer]}
                    </div>`;
                    })
                    .join("")}
            </div>
        `;
        optionsEl.appendChild(result);
    }

    loadQuestion();
</script>
