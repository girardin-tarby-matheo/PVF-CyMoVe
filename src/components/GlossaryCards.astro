---
export interface GlossaryItem {
  term: string;
  definition: string;
}

interface Props {
  terms?: GlossaryItem[];
  // Backwards compatibility if passed as cards
  cards?: { term?: string; front?: string; definition?: string; back?: string; type?: string }[];
}

const { terms, cards } = Astro.props;

// Normaliser les données d'entrée
const glossaryItems: GlossaryItem[] = terms ?? (
  cards
    ? cards
        .filter((c) => !c.type || c.type === "glossaire")
        .map((c) => ({
          term: c.term || c.front || "",
          definition: c.definition || c.back || "",
        }))
    : []
);
---

<section class="relative w-full py-6 [font-family:-apple-system,'Segoe_UI',system-ui,sans-serif]" aria-labelledby="glossary-section-title">
  <div class="mb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <div class="flex items-center gap-2.5">
      
        <h3 id="glossary-section-title" class="text-xl sm:text-2xl font-bold tracking-tight text-[#081924]">
          Notions clés
        </h3>
      </div>
      <p class="mt-1 text-[15px] text-[#46606b]">
        Devinez la définition de chaque mot, puis cliquez sur la carte pour vérifier la réponse.
      </p>
    </div>
   
  </div>

  <div class="grid grid-cols-1 justify-items-center gap-4 sm:grid-cols-2 md:grid-cols-4">
    {glossaryItems.map((item, idx) => (
      <button
        type="button"
        class="group block w-full max-w-[280px] cursor-pointer select-none appearance-none border-0 bg-transparent p-0 text-left [aspect-ratio:3/4] [font:inherit] [perspective:900px] [-webkit-tap-highlight-color:transparent] [filter:drop-shadow(0_4px_12px_rgba(16,24,40,0.08))] transition-[filter] duration-200 ease-in-out hover:[filter:drop-shadow(0_12px_28px_rgba(16,24,40,0.16))] focus-visible:rounded-2xl focus-visible:outline-[3px] focus-visible:outline-[#107AA5] focus-visible:outline-offset-4"
        data-glossary-card
        aria-pressed="false"
        aria-label={`Carte glossaire : ${item.term}. Cliquez pour afficher la définition.`}
      >
        <div class="glossary-card-inner relative h-full w-full [transform-style:preserve-3d] [will-change:transform] [transition:transform_0.75s_linear(0,0.008_1.1%,0.031_2.2%,0.129_4.8%,0.257_7.2%,0.671_14.2%,0.789_16.5%,0.881_18.6%,0.957_20.7%,1.019_22.9%,1.063_25.1%,1.094_27.4%,1.114_30.7%,1.112_34.5%,1.018_49.9%,0.99_59.1%,1)] hover:scale-[1.03] group-aria-[pressed=true]:[transform:rotateY(180deg)] motion-reduce:transform-none motion-reduce:transition-none">
          {/* RECTO */}
          <div class="absolute inset-0 z-[2] flex flex-col items-center justify-center gap-2.5 overflow-hidden rounded-2xl bg-white px-[18px] py-6 [backface-visibility:hidden] motion-reduce:[backface-visibility:visible] group-aria-[pressed=true]:motion-reduce:hidden">
            <svg
              class="absolute inset-0 z-0 h-full w-full rounded-[15px] pointer-events-none"
              viewBox="0 0 252 346"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <clipPath id={`glossary-clip-${idx}`}>
                  <rect width="252" height="346" rx="15" />
                </clipPath>
              </defs>
              <g clip-path={`url(#glossary-clip-${idx})`}>
                <rect width="252" height="346" fill="#FFFFFF" />
                <path
                  d="M49.4993 300C13.8993 318.4 3.33261 379 12.4993 390C97.4993 453 305.9 523.6 285.5 470C265.1 416.4 309.666 266 334.5 197.5C320.333 202 362.401 147.633 307.5 139.5C226.5 127.5 248.5 188.5 194 208.5C139.5 228.5 172 272 145 294.5C114 320.333 93.9993 277 49.4993 300Z"
                  fill="#0BA5B7"
                  fill-opacity="0.24"
                />
                <path
                  d="M231.216 54.9724C266.816 36.5724 277.382 -24.0276 268.216 -35.0276C183.216 -98.0276 -25.1847 -168.628 -4.78467 -115.028C15.6153 -61.4276 -28.9513 88.9724 -53.7847 157.472C-39.618 152.972 -81.6859 207.339 -26.7852 215.472C54.2148 227.473 4 177.472 58.5 157.472C113 137.473 67.9688 76.7863 125 47.5C162 28.5 186.716 77.9724 231.216 54.9724Z"
                  fill="#107AA5"
                  fill-opacity="0.46"
                />
              </g>
            </svg>
            <span class="relative z-[1] text-center text-[20px] font-bold leading-[1.3] text-[#107aa5] px-2">
              {item.term}
            </span>
            <span class="mt-auto inline-flex items-center gap-[5px] pt-1 text-[11px] font-semibold text-[#107aa5] opacity-80 group-aria-[pressed=true]:invisible">
              <svg class="opacity-80" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
              Retourner la carte
            </span>
          </div>

          {/* VERSO */}
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 overflow-hidden rounded-2xl border-[5px] border-[#107aa5] bg-white px-4 py-5 text-[#107aa5] [backface-visibility:hidden] [transform:rotateY(180deg)] motion-reduce:[transform:none] group-aria-[pressed=false]:motion-reduce:hidden">
            <span class="text-center text-[15px] font-bold leading-[1.2] text-[#107aa5] border-b border-[#107aa5]/20 pb-1 w-full">
              {item.term}
            </span>
            <span class="text-center text-[13px] sm:text-sm leading-[1.55] text-[#101828]">
              {item.definition}
            </span>
            <span class="mt-auto inline-flex items-center gap-1 text-[10px] text-[#64748b]">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
              Cliquer pour masquer
            </span>
          </div>
        </div>
      </button>
    ))}
  </div>
</section>

<script>
  function initGlossaryCards() {
    const cards = document.querySelectorAll<HTMLButtonElement>("[data-glossary-card]");

    cards.forEach((card) => {
      if (card.dataset.glossaryBound) return;
      card.dataset.glossaryBound = "1";

      function toggle() {
        const isFlipped = card.getAttribute("aria-pressed") === "true";
        const nextState = !isFlipped;
        card.setAttribute("aria-pressed", String(nextState));
        
        const term = card.querySelector(".glossary-card-inner")?.querySelector("span")?.textContent?.trim() || "";
        const label = nextState 
          ? `Carte glossaire : ${term}. Définition affichée. Cliquez pour masquer.` 
          : `Carte glossaire : ${term}. Cliquez pour afficher la définition.`;
        card.setAttribute("aria-label", label);
      }

      card.addEventListener("click", toggle);
      card.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGlossaryCards);
  } else {
    initGlossaryCards();
  }
  document.addEventListener("astro:page-load", initGlossaryCards);
</script>
