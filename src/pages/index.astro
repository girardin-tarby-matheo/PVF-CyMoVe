---
import Layout from "../layouts/Layout.astro";
import AttackDiagram from "../components/AttackDiagram.astro";
import FlipCardGrid from "../components/FlipCardGrid.astro";
import GlossaryCards from "../components/GlossaryCards.astro";
import GlossaryTerm from "../components/GlossaryTerm.astro";
import Footer from "../components/Footer.astro";
import NuageMots from "../components/NuageMots.astro";
import Starlink from "../components/Starlink.astro";
import Quiz from "../components/Quiz.astro";
import carImg from "../assets/car.png";
import houseImg from "../assets/house.png";
import CanadaFlag from "../assets/canada.svg";
import USAFlag from "../assets/usa.svg";
import JapanFlag from "../assets/japan.svg";
import RollsRoyceLogo from "../assets/image14.svg";
import MiniLogo from "../assets/image15.svg";
import BMWLogo from "../assets/image16.svg";
import CadenaImg from "../assets/cadena.webp";
import BlueImg from "../assets/blue.svg";
import TelephoneImg from "../assets/telephone.svg";
import WifiImg from "../assets/wifi.svg";
import SyntheseImg from "../assets/synthese.png";

const toyotaSteps = [
	{
		step: 1,
		text: "Le voleur débranche le câblage derrière le phare pour atteindre le bus CAN.",
	},
	{
		step: 2,
		text: "Un petit boîtier, parfois déguisé en enceinte Bluetooth, est branché sur ce connecteur.",
	},
	{
		step: 3,
		text: "L'appareil envoie un faux message qui imite celui d'une clé légitime.",
	},
	{
		step: 4,
		text: "L'immobiliseur accepte le message et désactive la protection du véhicule.",
	},
	{
		step: 5,
		text: "Le moteur démarre, sans qu'aucune vraie clé n'ait été utilisée.",
	},
];

const toyotaGlossary = [
	{
		term: "Bus CAN",
		definition:
			"Le réseau électronique interne qui permet aux composants d'une voiture de communiquer entre eux.",
	},
	{
		term: "Injection CAN",
		definition:
			"L'envoi d'un faux message sur le réseau pour tromper les autres composants.",
	},
	{
		term: "Immobiliseur",
		definition:
			"Le système qui empêche normalement le moteur de démarrer sans la bonne clé.",
	},
	{
		term: "Authentification",
		definition:
			"La vérification qu'un message vient bien de la personne ou de l'appareil annoncé.",
	},
];
---

<Layout>
	<div class="w-full min-h-screen text-[#071a27] font-sans antialiased">
		<main
			class="w-full max-w-[100%] pb-[160px] [@media(max-width:800px)]:pb-[80px] flex flex-col items-stretch justify-center"
		>
			<!-- HERO / INTRODUCTION -->
			<section
				class="scroll-mt-7 min-h-[calc(100vh-3rem)] flex flex-col justify-start pt-4 md:pt-8 mb-20"
				id="introduction"
			>
				<!-- Badges / Tags -->
				<div class="flex flex-wrap items-center gap-3 mb-6 md:mb-8">
					<span
						class="inline-flex items-center px-4 py-1.5 text-[#3b879e] text-[13.5px] font-medium tracking-wide"
					>
						Publication : 25/09/2026
					</span>
					<span
						class="inline-flex items-center px-4 py-1.5 text-[#3b879e] text-[13.5px] font-medium tracking-wide"
					>
						Temps de lecture estimé: 25 min
					</span>
				</div>

				<!-- Main 2-column Hero -->
				<div
					class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center my-auto"
				>
					<!-- Left Column: Title and intro paragraphs -->
					<div
						class="lg:col-span-7 flex flex-col gap-10 max-w-[620px]"
					>
						<h1
							class="Century Gothic text-[#0B5367] text-[clamp(48px,5.5vw,72px)] leading-[1.06] font-bold tracking-[-0.035em] text-balance m-0"
						>
							La menace de la<br />
							piraterie<br />
							automobile<br />
						</h1>

						<div
							class="top-5 text-[#345866] text-[18px] md:text-[19px] leading-[1.65] font-mona font-normal"
						>
							<p class="m-0">
								Ce module propose une lecture simple et concrète
								de situations réelles, pour mieux reconnaître
								les risques, adopter les bons réflexes, et
								protéger les données qui comptent.
								<br />
								Car la règle est simple, plus un véhicule est connecté,
								plus sa surface d'exposition aux cyberattaques s'élargit.
							</p>
						</div>
					</div>

					<!-- Right Column: Clustered Connected Vehicle Risk SVGs -->
					<div
						class="lg:col-span-5 relative flex items-center justify-center lg:justify-end w-full py-4"
					>
						<div
							class="hero-icons-cluster relative w-[340px] sm:w-[420px] md:w-[480px] lg:w-[460px] xl:w-[510px] aspect-[1/0.92]"
						>
							<!-- Telephone Circle (top-left) -->
							<div class="cluster-icon icon-phone">
								<img
									src={TelephoneImg.src}
									alt="Appels connectés"
									width="144"
									height="128"
									loading="eager"
								/>
							</div>

							<!-- Bluetooth Circle (top-right) -->
							<div class="cluster-icon icon-bluetooth">
								<img
									src={BlueImg.src}
									alt="Bluetooth"
									width="250"
									height="226"
									loading="eager"
								/>
							</div>

							<!-- Padlock Circle (main hero icon) -->
							<div class="cluster-icon icon-padlock">
								<img
									src={CadenaImg.src}
									alt="Cadenas ouvert vulnérable"
									width="480"
									height="471"
									loading="eager"
								/>
							</div>

							<!-- Wifi Circle (bottom-right) -->
							<div class="cluster-icon icon-wifi">
								<img
									src={WifiImg.src}
									alt="Wi-Fi connecté"
									width="187"
									height="184"
									loading="eager"
								/>
							</div>
						</div>
					</div>
				</div>

				<!-- Vidéo d'introduction -->

				<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mx-auto">
					<div class="mt-20 md:mt-28 mb-12">
						<figure
							class="w-full max-w-4xl mx-auto rounded-2xl overflow-hidden shadow-[0_16px_40px_rgba(7,40,58,0.09)] border-2 border-[#bfe7f1]"
						>
							<div
								class="overflow-hidden aspect-[16/8.5] bg-[#061521]"
							>
								<video
									class="block w-full h-full object-cover"
									src="https://api.preview.4hfactory.tech/storage/companies/2_6BZLRA9PU5/1486_XB5J2PAIOL/7320_19GEQTXSKH.webm"
									controls
									playsinline
									preload="metadata"
									aria-label="Vidéo d’introduction au parcours"
								></video>
							</div>
						</figure>
					</div>
					<div class="flex flex-col gap-4 justify-center">
						<p class="mb-[10px] text-[#5B7688] text-[18px]">
							Les enjeux de la <GlossaryTerm
								term="cybersécurité"
								definition="Les méthodes utilisées pour protéger les appareils, les réseaux et les informations contre les attaques."
							/> sont aujourd’hui partout : dans nos usages, nos outils
							et les services que nous utilisons chaque jour.
						</p>
						<p class="text-[#5B7688] text-[18px]">
							Le secteur automobile a vu les cyberattaques le
							visant augmenter de 225 % entre 2019 et 2022, avec
							parmi les méthodes les plus fréquentes le vol de
							véhicule par <GlossaryTerm
								term="relayage de signal"
								definition="Le fait de prolonger le signal de la vraie clé pour faire croire à la voiture qu'elle est juste à côté."
							/> et l'exploitation des systèmes d'<GlossaryTerm
								term="infodivertissement"
								definition="Le système qui regroupe l'écran, la musique, le GPS et parfois la connexion Internet de la voiture."
							/>.
						</p>
						<div
							class="justify-center text-sky-500 text-2xl font-bold font-['Mona_Sans'] leading-10"
						>
							Plus un véhicule est connecté, plus son degré
							d'exposition aux cyberattaques s'élargit.
						</div>
					</div>
				</div>
			</section>

			<!-- CAS 4 -->
			<section class="mb-[116px] scroll-mt-7" id="cas-4">
				<div
					class="flex mb-5 gap-7 flex-column display-flex display-blockalign-baseline"
				>
					<h2
						class="m-0 text-[#081924] text-[clamp(25px,3vw,44px)] leading-[1.1] tracking-[-0.052em] font-bold"
					>
						01 - CAN VIA PHARE <em class="text-[#1b70d3] not-italic"
							>Toyota Lexus</em
						>
					</h2>
					<p
						class="text-[#08a1d4] text-[20px] mt-1 font-(Segoe UI) font-bold tracking-[0.05em] uppercase border-2 border-[#08a1d4] rounded-[50px] px-2 py-1 inline-block"
					>
						2023
					</p>
				</div>
				<p
					class="mb-[10px] text-[#46606b] text-[18px] leading-[1.65] m-0"
				>
					En 2023, un vol de véhicule a mis en lumière une méthode
					inédite : l’<GlossaryTerm
						term="injection"
						definition="L'envoi d'un faux message dans un réseau pour tromper les autres appareils."
					/> de messages sur le <GlossaryTerm
						term="réseau CAN"
						definition="Le réseau électronique qui permet aux équipements d'une voiture de communiquer entre eux."
					/> via le connecteur d’un phare. Cette attaque permet de contourner
					la protection <GlossaryTerm
						term="antidémarrage"
						definition="Le système qui empêche le moteur de démarrer sans la bonne clé."
					/> et de déverrouiller les portes sans la clé.
				</p>
				<FlipCardGrid steps={toyotaSteps} />
				<GlossaryCards terms={toyotaGlossary} />

				<div
					class="mt-0 border-l-4 border-[#08a1d4] bg-white px-6 py-5 shadow-[0_10px_25px_rgba(11,40,80,0.05)] rounded-2xl"
				>
					<h3
						class="m-0 text-[#081924] text-[clamp(22px,2.4vw,32px)] leading-[1.15] font-bold"
					>
						À retenir
					</h3>
					<ul
						class="mt-3 mb-0 pl-0 text-[#46606b] text-[17px] leading-[1.6]"
					>
						<li>
							En 2023, de nombreux cas réels et témoignages ont
							mis en lumière une méthode de vol redoutable
							touchant des véhicules Toyota et Lexus : l'injection
							de messages malveillants directement sur le réseau
							CAN (le bus de communication interne de la voiture)
							en se branchant sur les câbles du phare avant.
						</li>
						<br />
						<li>
							Cette technique, dite « d'injection CAN », permet à
							un attaquant de simuler la présence de la clé
							officielle en quelques secondes seulement. Le
							système d'antidémarrage est ainsi dupé de
							l'intérieur, permettant d'ouvrir et de démarrer la
							voiture sans laisser la moindre trace d'effraction.
						</li>
						<br />
						<li>
							Ce cas marque les esprits car il concrétise une peur
							quotidienne : le vol en pleine rue, sous les
							fenêtres, de manière totalement silencieuse et
							ultra-rapide. Il rappelle que la sécurité d'un
							véhicule moderne ne dépend pas seulement de ses
							clés, mais aussi de la protection physique de ses
							connexions électroniques externes.
						</li>
					</ul>
				</div>
			</section>

			<!-- CAS 3 -->
			<section class="mb-[130px] scroll-mt-7" id="cas-3">
				<div class="flex mb-5 gap-7 flex-column">
					<h2
						class="m-0 text-[#081924] text-[clamp(25px,3vw,44px)] leading-[1.1] tracking-[-0.052em] font-bold"
					>
						02 - CLONAGE DE CLÉ <em
							class="text-[#1b70d3] not-italic">Tesla Model S</em
						>
					</h2>
					<p
						class="text-[#08a1d4] text-[20px] mt-1 font-(Segoe UI) font-bold tracking-[0.05em] uppercase border-2 border-[#08a1d4] rounded-[50px] px-2 py-1 inline-block"
					>
						2018
					</p>
				</div>
				<p
					class="mb-[10px] text-[#46606b] text-[18px] leading-[1.65] m-0"
				>
					En 2018, des chercheurs belges ont mis en évidence une
					faiblesse permettant de <GlossaryTerm
						term="cloner"
						definition="Créer une copie qui ressemble et fonctionne comme l'original."
					/> une clé de véhicule. Une clé ou un smartphone peut alors devenir
					un <GlossaryTerm
						term="point d'accès"
						definition="Un moyen d'entrer dans un appareil ou un réseau."
					/> au véhicule.
				</p>
				<p class="mb-4 text-[#0879ae] text-[17px] font-bold">
					Répondez aux questions ci-dessous pour en découvrir plus.
				</p>
				<div
					class="flex flex-auto gap-5 align-middle justify-center display-block items-start"
				>
					<div class="w-100% max-w-[600px]">
						<iframe
							width="600"
							height="315"
							src="https://www.youtube.com/embed/aVlYuPzmJoY?si=MTOEZBbc3XTQcldI"
							title="YouTube video player"
							frameborder="0"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							referrerpolicy="strict-origin-when-cross-origin"
							allowfullscreen
						>
						</iframe>
						<p
							class="mb-[10px] text-[#46606b] text-[18px] leading-[1.65] mt-7 max-w-[560px]"
						>
							<ul>
								<li>
									Derrière cette attaque se cachent des
									chercheurs belges qui ont exploité un
									<GlossaryTerm
										term="chiffrement"
										definition="Le fait de rendre un message illisible sans une clé pour le lire."
									/> sans contact obsolète (seulement 40 bits).
									L'aspect le plus marquant réside dans l'accessibilité
									de la méthode : le matériel nécessaire coûte environ
									600 euros et l'opération ne prend que quelques
									secondes à proximité de la cible.
								</li>
								<br />
								<li>
									Cet événement démontre qu'une grande marque
									technologique peut être <GlossaryTerm
										term="vulnérable"
										definition="Qui présente une faiblesse pouvant être exploitée."
									/> à cause d'un composant tiers défaillant. Pour
									contrer ce risque, Tesla a corrigé le problème
									via des mises à jour logicielles à distance et
									a instauré l'option « PIN to Drive », exigeant
									un code secret sur l'écran pour démarrer le véhicule.
								</li>
							</ul>
						</p>
					</div>
					<Quiz />
				</div>

				<div
					class="mt-10 border-l-4 border-[#08a1d4] bg-white px-6 py-5 shadow-[0_10px_25px_rgba(11,40,80,0.05)] rounded-2xl"
				>
					<h3
						class="m-0 text-[#081924] text-[clamp(22px,2.4vw,32px)] leading-[1.15] font-bold"
					>
						À retenir
					</h3>
					<p
						class="mt-3 mb-0 text-[#46606b] text-[17px] leading-[1.6]"
					>
						Cette attaque s'appuie sur un matériel accessible pour
						environ 600 euros exploitant une clé de chiffrement
						obsolète de 40 bits. Pour contrer ce type de
						vulnérabilité et empêcher le vol malgré le clonage,
						l'activation de l'option de sécurité « PIN to Drive »
						(exigeant la saisie d'un code secret sur l'écran de
						bord) s'avère indispensable.
					</p>
				</div>
			</section>

			<!-- CAS 2 -->
			<section class="mb-[116px] scroll-mt-7" id="cas-2">
				<div class="flex mb-5 gap-7 flex-column">
					<h2
						class="m-0 text-[#081924] text-[clamp(25px,3vw,44px)] leading-[1.1] tracking-[-0.052em] font-bold"
					>
						03 - HOMME DU MILIEU <em
							class="text-[#1b70d3] not-italic">BMW</em
						>
					</h2>
					<p
						class="text-[#08a1d4] text-[20px] mt-1 font-(Segoe UI) font-bold tracking-[0.05em] uppercase border-2 border-[#08a1d4] rounded-[50px] px-2 py-1 inline-block"
					>
						2015
					</p>
				</div>
				<p
					class="mb-[10px] text-[#46606b] text-[18px] leading-[1.65] m-0"
				>
					Deux chercheurs en sécurité ont découvert une <GlossaryTerm
						term="faille"
						definition="Une faiblesse dans un système qu'une personne malveillante peut exploiter."
					/> dans le service connecté d’un constructeur automobile. Cette
					démonstration permet de comprendre comment une fonctionnalité
					pratique peut devenir un <GlossaryTerm
						term="vecteur d'exposition"
						definition="Un moyen par lequel une information ou un système peut être exposé à un risque."
					/> lorsqu’elle n’est pas suffisamment protégée.
				</p>
				<p class="mb-4 text-[#0879ae] text-[17px] font-bold">
					Explorez le scénario ci-dessous.
				</p>

				<AttackDiagram />
				<div
					class="mt-10 border-l-4 border-[#08a1d4] bg-white px-6 py-5 shadow-[0_10px_25px_rgba(11,40,80,0.05)] rounded-2xl"
				>
					<h3
						class="m-0 text-[#081924] text-[clamp(22px,2.4vw,32px)] leading-[1.15] font-bold"
					>
						À retenir
					</h3>
					<ul
						class="mt-3 mb-0 pl-0 text-[#46606b] text-[17px] leading-[1.6]"
					>
						<li>
							En 2015, une faille majeure touchant le système BMW
							ConnectedDrive a été mise au jour grâce à un audit
							de l'ADAC. Ce cas marque les esprits car il écorne
							l'image d'une grande marque de prestige réputée pour
							sa rigueur, tout en affectant plus de 2,2 millions
							de véhicules (BMW, Mini et Rolls-Royce).
						</li>
						<br />
						<li>
							La vulnérabilité résidait dans la liaison sans fil
							entre les serveurs du constructeur et la <GlossaryTerm
								term="carte SIM"
								definition="La petite puce qui permet à un appareil de se connecter à un réseau mobile."
							/> intégrée aux véhicules. En exploitant des faiblesses
							dans le <GlossaryTerm
								term="protocole de communication"
								definition="L'ensemble des règles utilisées pour faire communiquer des appareils."
							/> et l'absence de
							<GlossaryTerm
								term="chiffrement"
								definition="Le fait de rendre un message illisible sans une clé pour le lire."
							/> robuste pour certains échanges, des chercheurs ont
							pu <GlossaryTerm
								term="intercepter"
								definition="Récupérer un message pendant qu'il circule entre deux appareils."
							/> les signaux et simuler de fausses connexions.
						</li>
						<br />
						<li>
							Cette intrusion a permis d'ouvrir les portières à
							distance sans clé physique, démontrant que les
							constructeurs de luxe doivent faire face aux mêmes
							défis de cybersécurité que les entreprises
							informatiques, la sécurité des <GlossaryTerm
								term="logiciels embarqués"
								definition="Les programmes installés directement dans un appareil, comme une voiture."
							/> devenant aussi cruciale que la robustesse mécanique.
						</li>
					</ul>
				</div>
				<!-- BLOCS MÉTRIQUES CAS 2 -->
				<h3
					class="mt-12 mb-4 text-[#081924] text-[clamp(22px,2.4vw,32px)] leading-[1.15] font-bold"
				>
					Les chiffres clés
				</h3>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-5 mx-auto">
					<div
						class="min-h-[150px] flex flex-col items-center justify-center p-6 rounded-[20px] bg-white border border-[rgba(157,210,225,0.6)] shadow-[0_17px_32px_rgba(79,156,178,0.12),0_2px_7px_rgba(62,123,141,0.08)] text-center transition-transform"
					>
						<strong
							id="vehicle-counter"
							class="text-[#3680d7] text-[42px] font-extrabold leading-none"
							data-target="2200000">0</strong
						>
						<span
							class="mt-2 text-[#1768b8] text-[17px] font-extrabold"
							>véhicules concernés par la faille</span
						>
					</div>

					<div
						class="min-h-[150px] flex flex-col items-center justify-center p-6 rounded-[20px] bg-white border border-[rgba(157,210,225,0.6)] shadow-[0_17px_32px_rgba(79,156,178,0.12),0_2px_7px_rgba(62,123,141,0.08)] text-center transition-transform"
					>
						<span
							class="text-[#3680d7] text-[18px] font-extrabold tracking-[0.05em] mb-4 uppercase"
							>3 marques concernées par la faille</span
						>
						<div
							class="flex justify-center items-center justify-between gap-6"
						>
							<img
								src={RollsRoyceLogo.src}
								alt="Rolls-Royce"
								class="h-13 w-auto object-contain drop-shadow-[0_1px_2px_rgba(0,0,0,0.15)]"
							/>
							<img
								src={MiniLogo.src}
								alt="MINI"
								class="h-13 w-auto object-contain drop-shadow-[0_1px_2px_rgba(0,0,0,0.15)]"
							/>
							<img
								src={BMWLogo.src}
								alt="BMW"
								class="h-13 w-auto object-contain drop-shadow-[0_1px_2px_rgba(0,0,0,0.15)]"
							/>
						</div>
					</div>

					<div
						class="min-h-[150px] flex flex-col items-center justify-center p-6 rounded-[20px] bg-white border border-[rgba(157,210,225,0.6)] shadow-[0_17px_32px_rgba(79,156,178,0.12),0_2px_7px_rgba(62,123,141,0.08)] text-center transition-transform"
					>
						<strong
							id="hack-time-counter"
							class="text-[#d75f36] text-[42px] font-extrabold leading-none"
							data-target="10">0</strong
						>
						<span
							class="mt-2 text-[#b84f17] text-[17px] font-extrabold"
							>minutes environ pour déverrouiller le véhicule</span
						>
					</div>
				</div>
			</section>

