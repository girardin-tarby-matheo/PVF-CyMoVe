---
const navItems = [
    { id: "introduction", label: "Introduction" },
    { id: "cas-4", label: "Cas 1" },
    { id: "cas-3", label: "Cas 2" },
    { id: "cas-2", label: "Cas 3" },
    { id: "cas-1", label: "Cas 4" },
    { id: "synthese", label: "Synthèse" },
];

import CymoveLogo from "../assets/cymove2.svg";
---

<div class="menu" data-collapsed="false">
    <aside class="sidebar" aria-label="Navigation du parcours">
        <button
            class="collapse-button"
            type="button"
            aria-label="Réduire le menu"
            aria-expanded="true"
            title="Réduire le menu"
        >
            <span class="collapse-chevron" aria-hidden="true"></span>
        </button>
        <div class="brand-logos">
            <img
                src={CymoveLogo.src}
                alt="Logo CyMove"
                width="60%"
                height="auto"
                loading="eager"
            />
        </div>

        <span class="brand-text">
            <strong>Quand les hackers</strong><br />
            <strong>ciblent nos voitures</strong><br />
            <small>Acculturation Cybersécurité</small>
        </span>

        <nav class="desktop-nav" aria-label="Sommaire principal">
            {
                navItems.map((item) => (
                    <a
                        class="nav-link"
                        href={`#${item.id}`}
                        data-label={item.label}
                        aria-current={item.id === "introduction" ? "step" : undefined}
                    >
                        <span class="nav-dot" aria-hidden="true" />
                        <span class="nav-text">{item.label}</span>
                    </a>
                ))
            }
        </nav>
    </aside>
</div>

<header class="mobile-header">
    <div class="mobile-brand">
        <img src={CymoveLogo.src} alt="Logo CyMove" width="40" height="auto" />
        <span class="brand-label">
            <strong>Acculturation</strong>
            <strong>Cybersécurité</strong>
        </span>
    </div>

    <details class="mobile-menu">
        <summary aria-label="Menu de navigation">
            <span class="hamburger-icon" aria-hidden="true"></span>
        </summary>
        <nav aria-label="Sommaire mobile">
            {navItems.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
        </nav>
    </details>
</header>

<script>
    const menu = document.querySelector<HTMLElement>(".menu");
    const layout = document.querySelector<HTMLElement>(".layout");
    const collapseButton =
        document.querySelector<HTMLButtonElement>(".collapse-button");
    const storageKey = "cymove-menu-collapsed";

    const setCollapsed = (collapsed: boolean, persist = true) => {
        if (!menu || !layout || !collapseButton) return;

        menu.dataset.collapsed = String(collapsed);
        layout.dataset.menuCollapsed = String(collapsed);
        collapseButton.setAttribute("aria-expanded", String(!collapsed));
        collapseButton.setAttribute(
            "aria-label",
            collapsed ? "Ouvrir le menu" : "Réduire le menu",
        );
        collapseButton.title = collapsed ? "Ouvrir le menu" : "Réduire le menu";

        if (persist) sessionStorage.setItem(storageKey, String(collapsed));
    };

    const savedState = sessionStorage.getItem(storageKey);
    const initialCollapsed =
        savedState === "true" ||
        (savedState === null && window.matchMedia("(max-width: 820px)").matches);
    setCollapsed(initialCollapsed, false);

    collapseButton?.addEventListener("click", () => {
        setCollapsed(menu?.dataset.collapsed !== "true");
    });

    // Gestion du ScrollSpy et de l'interactivité mobile
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(
        ".desktop-nav .nav-link",
    );
    const mobileLinks =
        document.querySelectorAll<HTMLAnchorElement>(".mobile-menu nav a");
    const mobileMenu =
        document.querySelector<HTMLDetailsElement>(".mobile-menu");

    // Auto-fermeture du menu mobile lors de la sélection d'un lien
    mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
            if (mobileMenu) mobileMenu.open = false;
        });
    });

    // Observer pour le défilement (ScrollSpy)
    const sections = Array.from(navLinks)
        .map((link) => {
            const id = link.getAttribute("href")?.substring(1);
            return id ? document.getElementById(id) : null;
        })
        .filter((section): section is HTMLElement => section !== null);

    if (sections.length > 0) {
        const observerOptions = {
            root: null,
            rootMargin: "-20% 0px -60% 0px",
            threshold: 0,
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const activeId = entry.target.id;
                    let pastActive = false;

                    navLinks.forEach((link) => {
                        const href = link.getAttribute("href")?.substring(1);
                        if (href === activeId) {
                            link.classList.add("active");
                            link.classList.remove("past");
                            link.setAttribute("aria-current", "step");
                            pastActive = true;
                        } else if (!pastActive) {
                            link.classList.add("past");
                            link.classList.remove("active");
                            link.removeAttribute("aria-current");
                        } else {
                            link.classList.remove("active", "past");
                            link.removeAttribute("aria-current");
                        }
                    });
                }
            });
        }, observerOptions);

        sections.forEach((section) => observer.observe(section));
    }
</script>

<style>
    :global(*) {
        box-sizing: border-box;
    }
    :global(:root) {
        font-family:
            "Inter",
            system-ui,
            -apple-system,
            sans-serif;
        color: #071a27;
        background: #effbfe;
        font-synthesis: none;
    }
    :global(html) {
        scroll-behavior: smooth;
    }
    :global(body) {
        margin: 0;
        min-width: 320px;
        background: #effbfe;
    }

    /* Dépend du site parent : remplacez cette valeur par la hauteur de son en-tête. */
    :global(:root) {
        --parent-header-height: 0px;
        --menu-open-width: 280px;
        --menu-collapsed-width: 72px;
        --menu-transition: 300ms ease-in-out;
    }

    :global(.layout) {
        display: grid !important;
        grid-template-columns: var(--menu-open-width) minmax(0, 1fr);
        transition: grid-template-columns var(--menu-transition);
    }

    :global(.layout[data-menu-collapsed="true"]) {
        grid-template-columns: var(--menu-collapsed-width) minmax(0, 1fr);
    }

    .menu {
        position: relative;
        width: var(--menu-open-width);
        min-width: 0;
        overflow: visible;
        z-index: 3;
        transition: width var(--menu-transition);
    }

    .menu[data-collapsed="true"] {
        width: var(--menu-collapsed-width);
    }

    /* Layout principal */
    .sidebar {
        position: sticky;
        top: var(--parent-header-height);
        align-self: start;
        width: 100%;
        height: calc(100vh - var(--parent-header-height));
        display: flex;
        flex-direction: column;
        padding: 28px 20px 28px 24px;
        color: #0b6287;
        overflow-y: auto;
        margin-right: 0;
        overflow-x: hidden;
        transition: padding var(--menu-transition);
    }

    .collapse-button {
        position: absolute;
        top: 12px;
        right: 8px;
        z-index: 4;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        
        border-radius: 50%;
        color: #0b6287;
        background: #c9edf5;
      
        cursor: pointer;
        transition:
            background-color var(--menu-transition),
            border-color var(--menu-transition),
            box-shadow var(--menu-transition),
            transform var(--menu-transition);
    }

    .collapse-button:hover,
    .collapse-button:focus-visible {
        background: #a9dce9;
        border-color: rgba(15, 115, 156, 0.42);
        box-shadow: 0 3px 10px rgba(7, 40, 58, 0.22);
    }

    .collapse-button:hover {
        transform: translateX(1px);
    }

    .collapse-button:focus-visible {
        outline: 2px solid #0f739c;
        outline-offset: 2px;
    }

    .collapse-chevron {
        display: block;
        width: 8px;
        height: 8px;
        border-top: 2px solid currentColor;
        border-right: 2px solid currentColor;
        transform: rotate(-135deg);
        transform-origin: center;
        transition: transform var(--menu-transition);
    }

    .menu[data-collapsed="true"] .collapse-chevron {
        transform: rotate(45deg);
    }

    .brand-logos {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 50px;
        overflow: hidden;
        opacity: 1;
        max-width: 100%;
        transition: opacity var(--menu-transition), max-width var(--menu-transition), margin var(--menu-transition);
    }

    .brand-logos img {
        display: block;
        width: auto;
        height: auto;
        object-fit: contain;
    }

    .brand-logos img:first-child {
        width: 130px;
        max-width: 100%;
    }

    .brand-text {
        font-size: 25px;
        line-height: 1.35;
        color: #07283a;
        display: block;
        overflow: hidden;
        white-space: nowrap;
        opacity: 1;
        max-width: 100%;
        transition: opacity var(--menu-transition), max-width var(--menu-transition), margin var(--menu-transition);
    }

    /* Sommaire Desktop & Barre de progression */
    .desktop-nav {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 28px;
        margin: 36px 0 0 12px;
        padding-left: 24px;
        transition: margin var(--menu-transition), padding var(--menu-transition);
    }

    .nav-link {
        position: relative;
        display: flex;
        align-items: center;
        text-decoration: none;
        color: #5c99ae;
        outline: none;
        transition: color 0.2s ease;
        z-index: 2;
        min-height: 40px;
    }

    .nav-link:focus-visible {
        outline: 2px solid #0f739c;
        outline-offset: 4px;
        border-radius: 4px;
    }

    .nav-text {
        font-size: 15px;
        font-weight: 700;
        line-height: 1.2;
        transition:
            font-size 0.2s ease,
            color 0.2s ease,
            opacity var(--menu-transition),
            max-width var(--menu-transition);
        overflow: hidden;
        white-space: nowrap;
        max-width: 180px;
        opacity: 1;
    }

    /* Puce inactive */
    .nav-dot {
        position: absolute;
        left: -24px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #89bece;
        transform: translateX(-50%);
        transition:
            background-color 0.2s ease,
            width 0.2s ease,
            height 0.2s ease;
    }

    /* Segment vertical de progression */
    .nav-link::after {
        content: "";
        position: absolute;
        left: -24px;
        top: -34px;
        height: 38px;
        width: 4px;
        background: #0f739c;
        transform: translateX(-50%);
        opacity: 0;
        transition: opacity 0.2s ease;
        z-index: 1;
    }

    .nav-link:first-child::after {
        display: none;
    }

    /* États Actif & Passé */
    .nav-link.active .nav-text {
        color: #0f739c;
        font-size: 22px;
        font-weight: 800;
    }

    .nav-link.active .nav-dot {
        width: 14px;
        height: 14px;
        background: #0f739c;
    }

    .nav-link.active::after,
    .nav-link.past::after {
        opacity: 1;
    }

    .nav-link.past .nav-dot {
        background: #0f739c;
    }

    .nav-link.past .nav-text {
        color: #5c99ae;
    }

    .nav-link:hover .nav-text {
        color: #0f739c;
    }

    .menu[data-collapsed="true"] .sidebar {
        padding-left: 36px;
        padding-right: 20px;
    }

    .menu[data-collapsed="true"] .collapse-button {
        right: 20px;
    }

    .menu[data-collapsed="true"] .brand-logos,
    .menu[data-collapsed="true"] .brand-text {
        max-width: 0;
        margin-bottom: 0;
        opacity: 0;
    }

    .menu[data-collapsed="true"] .desktop-nav {
        margin-left: 0;
        padding-left: 24px;
    }

    .menu[data-collapsed="true"] .nav-text {
        max-width: 0;
        opacity: 0;
    }

    .menu[data-collapsed="true"] .nav-link::before {
        content: attr(data-label);
        position: absolute;
        left: 28px;
        z-index: 5;
        width: max-content;
        max-width: 180px;
        padding: 8px 10px;
        border-radius: 4px;
        color: #07283a;
        background: #ffffff;
        box-shadow: 0 4px 14px rgba(7, 40, 58, 0.16);
        font-size: 13px;
        font-weight: 700;
        opacity: 0;
        pointer-events: none;
        transform: translateY(4px);
        transition: opacity 150ms ease, transform 150ms ease;
    }

    .menu[data-collapsed="true"] .nav-link:hover::before,
    .menu[data-collapsed="true"] .nav-link:focus-visible::before {
        opacity: 1;
        transform: translateY(0);
    }

    /* Pied de sidebar */
    .sidebar-line {
        width: 100%;
        height: 1px;
        margin-top: auto;
        padding-top: 24px;
        border-bottom: 1px solid #b8e5f1;
    }

    .sidebar-note {
        margin: 14px 0 0;
        color: #5c99ae;
        font-size: 11px;
        line-height: 1.5;
    }

    /* Header Mobile */
    .mobile-header {
        display: none;
    }

    @media (max-width: 820px) {
        :global(.layout),
        :global(.layout[data-menu-collapsed="true"]) {
            grid-template-columns: var(--menu-collapsed-width) minmax(0, 1fr);
        }

        :global(.layout[data-menu-collapsed="false"]) {
            grid-template-columns: var(--menu-open-width) minmax(0, 1fr);
        }

        .menu {
            width: var(--menu-collapsed-width);
        }

        .sidebar {
            display: flex;
            height: calc(100vh - var(--parent-header-height));
            padding-left: 36px;
            padding-right: 20px;
        }

        .menu[data-collapsed="false"] {
            width: var(--menu-open-width);
        }

        .mobile-header {
            display: none;
        }

        .mobile-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-label {
            font-size: 12px;
            line-height: 1.2;
            color: #07283a;
        }

        .mobile-menu {
            position: relative;
        }

        .mobile-menu summary {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            list-style: none;
            cursor: pointer;
            border-radius: 8px;
            background: rgba(184, 229, 241, 0.3);
        }

        .mobile-menu summary::-webkit-details-marker {
            display: none;
        }

        .hamburger-icon,
        .hamburger-icon::before,
        .hamburger-icon::after {
            display: block;
            width: 18px;
            height: 2px;
            border-radius: 2px;
            background: #087da5;
            position: relative;
            transition: background 0.2s ease;
        }

        .hamburger-icon::before,
        .hamburger-icon::after {
            content: "";
            position: absolute;
            left: 0;
        }

        .hamburger-icon::before {
            top: -6px;
        }

        .hamburger-icon::after {
            top: 6px;
        }

        .mobile-menu nav {
            position: absolute;
            right: 0;
            top: 48px;
            display: flex;
            flex-direction: column;
            width: 200px;
            padding: 8px;
            border: 1px solid #b7e2ed;
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 12px 28px rgba(7, 40, 58, 0.12);
        }

        .mobile-menu nav a {
            padding: 12px 14px;
            color: #0b6287;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 6px;
            transition: background-color 0.15s ease;
        }

        .mobile-menu nav a:hover,
        .mobile-menu nav a:focus-visible {
            background: #effbfe;
            color: #0f739c;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(html) {
            scroll-behavior: auto;
        }
        .nav-link,
        .nav-text,
        .nav-dot,
        .nav-link::after,
        .collapse-button,
        .collapse-chevron {
            transition: none !important;
        }
    }

    .brand-text small {
        font-size: 15px;
        color: #0b6287;
        opacity: 0.85;
        line-height: -1000;
    }
</style>
