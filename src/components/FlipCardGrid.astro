---

interface GlossaryCard {
  type: "glossaire";
  front: string;
  back: string;
}

interface StepCard {
  type: "etape";
  step: number;
  front: string;
  back: string;
}

export type FlipCard = GlossaryCard | StepCard;

interface Props {
  cards: FlipCard[];
}

const { cards } = Astro.props;

// Séparer glossaire et étapes, trier les étapes par numéro
const glossaryCards = cards.filter((c): c is GlossaryCard => c.type === "glossaire");
const stepCards = cards
  .filter((c): c is StepCard => c.type === "etape")
  .sort((a, b) => a.step - b.step);
---

<section class="flipcard-grid-wrapper" aria-label="Jeu de cartes pédagogiques">
  <noscript>
    <p class="flipcard-noscript">
      Les cartes ci-dessous sont entièrement consultables.
      Pour activer l'animation de retournement, activez JavaScript dans votre navigateur.
    </p>
  </noscript>

  {/* ── SVG Defs partagées (textures) ── */}
  <svg class="flipcard-svg-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="flipcard-texture" width="4" height="4" patternTransform="scale(2.5)" patternUnits="userSpaceOnUse">
        <path fill="#000000" d="M1 3h1v1H1V3zm2-2h1v1H3V1z"></path>
      </pattern>
      <pattern id="flipcard-back-pattern-blue" width="20" height="20" patternTransform="rotate(30) scale(1.2)" patternUnits="userSpaceOnUse">
        <rect width="100%" height="100%" fill="#e8f0fe"/>
        <circle cx="10" cy="10" r="1.5" fill="#2F6FED" opacity="0.15"/>
        <circle cx="0" cy="0" r="1.5" fill="#2F6FED" opacity="0.1"/>
        <circle cx="20" cy="0" r="1.5" fill="#2F6FED" opacity="0.1"/>
        <circle cx="0" cy="20" r="1.5" fill="#2F6FED" opacity="0.1"/>
        <circle cx="20" cy="20" r="1.5" fill="#2F6FED" opacity="0.1"/>
      </pattern>
      <pattern id="flipcard-back-pattern-amber" width="20" height="20" patternTransform="rotate(-15) scale(1.2)" patternUnits="userSpaceOnUse">
        <rect width="100%" height="100%" fill="#fef7e6"/>
        <path fill="none" stroke="#f59e0b" stroke-width="0.8" opacity="0.18" d="M0 10 Q5 5, 10 10 Q15 15, 20 10"/>
        <path fill="none" stroke="#f59e0b" stroke-width="0.8" opacity="0.12" d="M0 0 Q5 -5, 10 0 Q15 5, 20 0"/>
        <path fill="none" stroke="#f59e0b" stroke-width="0.8" opacity="0.12" d="M0 20 Q5 15, 10 20 Q15 25, 20 20"/>
      </pattern>
    </defs>
  </svg>

  {/* ── Étapes ── */}
  {stepCards.length > 0 && (
    <div class="flipcard-section">
      <h3 class="flipcard-section-title">
        <span class="flipcard-section-icon flipcard-section-icon--etape">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        Étapes de l'attaque
      </h3>
      <div class="flipcard-row flipcard-row--steps">
        {stepCards.map((card) => (
          <button
            type="button"
            class="flipcard flipcard--etape"
            data-flipcard
            aria-pressed="false"
          >
            <div class="flipcard-inner">
              {/* RECTO */}
              <div class="flipcard-face flipcard-front flipcard-front--etape">
                <svg
                  class="flipcard-step-illustration"
                  viewBox="0 0 252 346"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <defs>
                    <clipPath id={`step-card-clip-${card.step}`}>
                      <rect width="252" height="346" rx="15" />
                    </clipPath>
                  </defs>
                  <g clip-path={`url(#step-card-clip-${card.step})`}>
                    <rect width="252" height="346" fill="#FFFFFF" />
                  <path
                    d="M49.4993 300C13.8993 318.4 3.33261 379 12.4993 390C97.4993 453 305.9 523.6 285.5 470C265.1 416.4 309.666 266 334.5 197.5C320.333 202 362.401 147.633 307.5 139.5C226.5 127.5 248.5 188.5 194 208.5C139.5 228.5 172 272 145 294.5C114 320.333 93.9993 277 49.4993 300Z"
                    fill="#A6C4FF"
                    fill-opacity="0.41"
                  />
                  <path
                    d="M231.216 54.9724C266.816 36.5724 277.382 -24.0276 268.216 -35.0276C183.216 -98.0276 -25.1847 -168.628 -4.78467 -115.028C15.6153 -61.4276 -28.9513 88.9724 -53.7847 157.472C-39.618 152.972 -81.6859 207.339 -26.7852 215.472C54.2148 227.473 4 177.472 58.5 157.472C113 137.473 67.9688 76.7863 125 47.5C162 28.5 186.716 77.9724 231.216 54.9724Z"
                    fill="#A6C4FF"
                  />
                  </g>
                </svg>
                <span class="flipcard-step-number">{card.step}</span>
                <span class="flipcard-step-label">Étape</span>
                <span class="flipcard-hint">
                  <svg class="flipcard-hint-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                  Retourner
                </span>
              </div>
              {/* VERSO */}
              <div class="flipcard-face flipcard-back flipcard-back--etape">
                <span class="flipcard-back-step-number">{card.step}</span>
                <span class="flipcard-back-step-label">Étape</span>
                <span class="flipcard-definition">{card.back}</span>
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>
  )}

  {/* ── Glossaire ── */}
  {glossaryCards.length > 0 && (
    <div class="flipcard-section">
      <h3 class="flipcard-section-title">
        <span class="flipcard-section-icon flipcard-section-icon--glossaire">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </span>
        Glossaire
      </h3>
      <div class="flipcard-row">
        {glossaryCards.map((card) => (
          <button
            type="button"
            class="flipcard flipcard--glossaire"
            data-flipcard
            aria-pressed="false"
          >
            <div class="flipcard-inner">
              {/* RECTO */}
              <div class="flipcard-face flipcard-front flipcard-front--glossaire">
                <svg class="flipcard-overlay-texture" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="url(#flipcard-texture)" opacity=".06"/></svg>
                <span class="flipcard-badge flipcard-badge--glossaire"></span>
                <span class="flipcard-term">{card.front}</span>
                <span class="flipcard-hint">
                  <svg class="flipcard-hint-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                  Retourner
                </span>
              </div>
              {/* VERSO */}
              <div class="flipcard-face flipcard-back flipcard-back--glossaire">
                <svg class="flipcard-overlay-texture" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="url(#flipcard-back-pattern-blue)" /><rect width="100%" height="100%" fill="url(#flipcard-texture)" opacity=".04"/></svg>
                <span class="flipcard-badge flipcard-badge--glossaire">Glossaire</span>
                <span class="flipcard-back-title">{card.front}</span>
                <span class="flipcard-definition">{card.back}</span>
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  /* ───────────────────────────────────────────────
     SVG defs – hidden but must remain in DOM
     ─────────────────────────────────────────────── */
  .flipcard-svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* ───────────────────────────────────────────────
     Wrapper
     ─────────────────────────────────────────────── */
  .flipcard-grid-wrapper {
    position: relative;
    width: 100%;
    padding: 32px 0;
    background: linear-gradient(180deg, #ffffff 0%, #eef4fb 100%);
    font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
  }

  .flipcard-noscript {
    max-width: 700px;
    margin: 0 auto 24px;
    padding: 12px 16px;
    background: #fef3c7;
    border: 1px solid #f3e0b2;
    border-radius: 8px;
    color: #92400e;
    font-size: 14px;
    text-align: center;
  }

  /* ───────────────────────────────────────────────
     Sections
     ─────────────────────────────────────────────── */
  .flipcard-section {
    margin-bottom: 36px;
  }

  .flipcard-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    font-size: 20px;
    font-weight: 700;
    color: #101828;
    letter-spacing: -0.01em;
  }

  .flipcard-section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
  }

  .flipcard-section-icon--glossaire {
    background: #dbeafe;
    color: #ffffff;
  }

  .flipcard-section-icon--etape {
    background: #fef3c7;
    color: #d97706;
  }

  /* ───────────────────────────────────────────────
     Grilles
     ─────────────────────────────────────────────── */
  .flipcard-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 20px;
  }

  .flipcard-row--steps {
    grid-template-columns: repeat(auto-fill, minmax(180px, 252px));
  }

  /* ───────────────────────────────────────────────
     Carte (bouton)
     ─────────────────────────────────────────────── */
  .flipcard {
    /* Reset du bouton SANS casser le focus */
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: left;
    perspective: 900px;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
    /* drop-shadow instead of box-shadow for a more natural feel */
    filter: drop-shadow(0 4px 12px rgba(16, 24, 40, 0.08));
    transition: filter 0.25s ease;
  }

  .flipcard--etape {
    aspect-ratio: 252 / 346;
  }

  .flipcard:hover {
    filter: drop-shadow(0 12px 28px rgba(16, 24, 40, 0.16));
  }

  .flipcard:focus-visible {
    outline: 3px solid #2F6FED;
    outline-offset: 4px;
    border-radius: 16px;
  }

  /* ───────────────────────────────────────────────
     Conteneur interne (rotation)
     ─────────────────────────────────────────────── */
  .flipcard-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    /* Springy bounce timing function inspired by the CodePen playing card */
    transition: transform 0.75s
      linear(
        0, 0.008 1.1%, 0.031 2.2%, 0.129 4.8%, 0.257 7.2%,
        0.671 14.2%, 0.789 16.5%, 0.881 18.6%, 0.957 20.7%,
        1.019 22.9%, 1.063 25.1%, 1.094 27.4%, 1.114 30.7%,
        1.112 34.5%, 1.018 49.9%, 0.99 59.1%, 1
      );
  }

  /* Hover lift — subtle 3D tilt + scale */
  .flipcard:hover .flipcard-inner {
    transform: scale(1.04) rotate3d(1, 1, 0, 2deg);
  }

  /* État retourné — piloté par JS via aria-pressed */
  .flipcard[aria-pressed="true"] .flipcard-inner {
    transform: rotateY(180deg);
  }

  .flipcard[aria-pressed="true"]:hover .flipcard-inner {
    transform: rotateY(180deg) scale(1.04) rotate3d(1, 1, 0, 2deg);
  }

  /* ── prefers-reduced-motion : fondu au lieu de rotation ── */
  @media (prefers-reduced-motion: reduce) {
    .flipcard-inner {
      transition: none;
      transform-style: flat;
      will-change: auto;
    }

    .flipcard:hover .flipcard-inner {
      transform: none;
    }

    .flipcard[aria-pressed="true"] .flipcard-inner {
      transform: none;
    }

    .flipcard[aria-pressed="true"]:hover .flipcard-inner {
      transform: none;
    }

    .flipcard-front {
      transition: opacity 0.3s ease;
    }

    .flipcard-back {
      transition: opacity 0.3s ease;
    }

    .flipcard[aria-pressed="true"] .flipcard-front {
      opacity: 0;
      pointer-events: none;
    }

    .flipcard[aria-pressed="true"] .flipcard-back {
      opacity: 1;
    }

    .flipcard-face {
      backface-visibility: visible;
    }

    .flipcard-back {
      opacity: 0;
      position: absolute;
      inset: 0;
      transform: none;
    }
  }

  /* ───────────────────────────────────────────────
     Faces
     ─────────────────────────────────────────────── */
  .flipcard-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px 18px;
    border-radius: 16px;
    backface-visibility: hidden;
    overflow: hidden;
    gap: 10px;
  }

  .flipcard-front {
    z-index: 2;
    background: #ffffff;
  }

  .flipcard-back {
    transform: rotateY(180deg);
    background: #ffffff;
  }

  /* SVG texture overlay (like the CodePen's card-texture) */
  .flipcard-overlay-texture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: multiply;
  }

  /* Make sure all inner content sits above the texture */
  .flipcard-badge,
  .flipcard-term,
  .flipcard-step-number,
  .flipcard-definition,
  .flipcard-hint {
    position: relative;
    z-index: 1;
  }

  /* ── Bordures distinctives ── */
  .flipcard-front--glossaire {
    border: 2px solid #d1d8e7;
    box-shadow:
      inset 0 0 0 3px rgba(47, 111, 237, 0.06),
      0 1px 3px rgba(16, 24, 40, 0.07);
  }




  .flipcard-front--etape {
    border: 0;
    background: #ffffff;
    box-shadow: none;
  }

  .flipcard-back--etape {
    border: 5px solid #a6c4ff;
    background: #ffffff;
    box-shadow: none;
    color: #86aaf2;
  }

  /* ───────────────────────────────────────────────
     Badges
     ─────────────────────────────────────────────── */
  .flipcard-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .flipcard-badge--etape {
    background: #fef3c7;
    color: #92400e;
  }

  /* ───────────────────────────────────────────────
     Contenu texte
     ─────────────────────────────────────────────── */
  .flipcard-term {
    font-size: 18px;
    font-weight: 700;
    color: #101828;
    text-align: center;
    line-height: 1.3;
  }

  .flipcard-back-title {
    font-size: 15px;
    font-weight: 700;
    color: #2F6FED;
    text-align: center;
    line-height: 1.2;
    margin-top: 2px;
  }

  .flipcard-step-number {
    position: absolute;
    z-index: 1;
    top: 32%;
    left: 50%;
    transform: translateX(-50%);
    font-size: clamp(48px, 5vw, 70px);
    font-weight: 800;
    color: #a6c4ff;
    line-height: 1;
  }

  .flipcard-step-label {
    position: absolute;
    z-index: 1;
    top: 51%;
    left: 50%;
    transform: translateX(-50%);
    color: #a6c4ff;
    font-size: clamp(15px, 1.7vw, 22px);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .flipcard-step-illustration {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    border-radius: 15px;
  }

  .flipcard-back-step-number,
  .flipcard-back-step-label {
    position: relative;
    z-index: 1;
    color: #a6c4ff;
  }

  .flipcard-back-step-number {
    font-size: clamp(42px, 4vw, 58px);
    font-weight: 800;
    line-height: 0.9;
  }

  .flipcard-back-step-label {
    margin-top: -2px;
    font-size: clamp(13px, 1.4vw, 18px);
    font-weight: 800;
    text-transform: uppercase;
  }

  .flipcard-back--etape .flipcard-definition {
    position: relative;
    z-index: 1;
    max-width: 90%;
    margin-top: 8px;
    color: #46679f;
  }

  .flipcard-definition {
    font-size: 14px;
    line-height: 1.6;
    color: #101828;
    text-align: center;
  }

  .flipcard-hint {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: #6b7280;
    font-style: italic;
    margin-top: auto;
    padding-top: 4px;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .flipcard:hover .flipcard-hint {
    opacity: 1;
  }

  .flipcard-hint-icon {
    opacity: 0.6;
  }

  /* Hide hint once flipped */
  .flipcard[aria-pressed="true"] .flipcard-hint {
    visibility: hidden;
  }
</style>

<script>
  // Interactivité des cartes — retournement au clic / clavier
  function initFlipCards() {
    const cards = document.querySelectorAll<HTMLButtonElement>("[data-flipcard]");

    cards.forEach((card) => {
      // Guard against double-binding when Astro view transitions re-fire
      if (card.dataset.flipcardBound) return;
      card.dataset.flipcardBound = "1";

      function toggle() {
        const isFlipped = card.getAttribute("aria-pressed") === "true";
        card.setAttribute("aria-pressed", String(!isFlipped));
      }

      card.addEventListener("click", toggle);

      card.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });
    });
  }

  // S'exécute quand le DOM est prêt (compatible Astro view transitions)
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFlipCards);
  } else {
    initFlipCards();
  }

  // Support Astro view transitions (si activées)
  document.addEventListener("astro:page-load", initFlipCards);
</script>
