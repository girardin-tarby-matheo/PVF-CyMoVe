<div
    class="w-full max-w-4xl mx-auto p-6 bg-white text-slate-800 rounded-xl border border-slate-200 shadow-lg font-sans relative overflow-hidden min-w-full"
>
    <p class="relative z-10 mb-4 text-center text-sm text-slate-500">
        Cliquez sur une étape pour découvrir le déroulé de l'attaque.
    </p>

    <!-- Boutons de navigation par étapes -->
    <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6">
        <button data-step="1" class="step-btn">
            <span class="block text-[10px] text-slate-400 font-mono mb-0.5"
                >01</span
            >
            Requête initiale
        </button>
        <button data-step="2" class="step-btn">
            <span class="block text-[10px] text-slate-400 font-mono mb-0.5"
                >02</span
            >
            Faux certificat
        </button>
        <button data-step="3" class="step-btn">
            <span class="block text-[10px] text-slate-400 font-mono mb-0.5"
                >03</span
            >
            Chemin contourné
        </button>
        <button data-step="4" class="step-btn">
            <span class="block text-[10px] text-slate-400 font-mono mb-0.5"
                >04</span
            >
            Commande injectée
        </button>
    </div>
    <!-- Schéma interactif avec grille alignée à 5 colonnes (Blocs + Connecteurs) -->
    <div
        class="relative z-10 bg-slate-50/70 rounded-lg p-6 border border-slate-200/80"
    >
        <div
            class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr_auto_1fr] gap-4 items-center text-center"
        >
            <!-- 1. Véhicule BMW -->
            <div
                id="node-car-card"
                class="node-card border-slate-200 bg-white shadow-sm"
            >
                <div
                    id="car-icon-container"
                    class="w-12 h-12 mx-auto mb-3 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-600 transition-all duration-300"
                >
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M8 17a2 2 0 100 4 2 2 0 000-4zm8 0a2 2 0 100 4 2 2 0 000-4zm-11-4h14l-1.5-4.5a2 2 0 00-1.9-1.5H8.4a2 2 0 00-1.9 1.5L5 13zm-2 0v4a1 1 0 001 1h1m16-5v4a1 1 0 00-1 1h-1M3 13h18"
                        ></path>
                    </svg>
                </div>
                <p class="font-semibold text-xs text-slate-800">Véhicule BMW</p>
                <span
                    id="car-state"
                    class="inline-block mt-2 px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 text-slate-600 border border-slate-200"
                >
                    Verrouillé
                </span>
            </div>

            <!-- Connecteur 1 (Entre Voiture et Attaquant) -->
            <div class="hidden md:flex justify-center items-center w-12">
                <svg
                    class="w-12 h-6 overflow-visible"
                    stroke-width="8"
                    fill="none"
                >
                    <path
                        d="M 0 20 H 48"
                        id="line-car-attacker"
                        class="stroke-slate-300 transition-all duration-500"
                    ></path>
                </svg>
            </div>

            <!-- 2. Attaquant / Proxy -->
            <div
                id="node-attacker-card"
                class="node-card border-slate-200 bg-white shadow-sm transition-all"
            >
                <div
                    id="attacker-icon-container"
                    class="w-12 h-12 mx-auto mb-3 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-600 transition-all duration-300"
                >
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                        ></path>
                    </svg>
                </div>
                <p class="font-semibold text-xs text-slate-800">
                    Attaquant (Proxy)
                </p>
                <p
                    id="attacker-subtext"
                    class="text-[11px] font-mono text-slate-500 mt-1"
                >
                    Imitation Serveur BMW
                </p>
            </div>

            <!-- Connecteur 2 (Entre Attaquant et Serveur) -->
            <div class="hidden md:flex justify-center items-center w-12">
                <svg
                    class="w-12 h-6 overflow-visible"
                    stroke-width="8"
                    fill="none"
                >
                    <path
                        d="M 0 20 H 48"
                        id="line-attacker-server"
                        class="stroke-slate-300 transition-all duration-500"
                    ></path>
                </svg>
            </div>

            <!-- 3. Serveur BMW Légitime -->
            <div
                id="node-server-card"
                class="node-card border-slate-200 bg-white shadow-sm transition-all"
            >
                <div
                    id="server-icon-container"
                    class="w-12 h-12 mx-auto mb-3 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-600 transition-all"
                >
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"
                        ></path>
                    </svg>
                </div>
                <p
                    class="font-semibold text-xs text-slate-800"
                    id="server-title"
                >
                    Serveur BMW Légitime
                </p>
                <p
                    class="text-[11px] font-mono text-slate-500 mt-1"
                    id="server-subtext"
                >
                    Chemin normal
                </p>
            </div>
        </div>
    </div>

    <!-- Commentaire de l'étape sélectionnée -->
    <div
        class="relative z-10 mt-5 p-3.5 rounded-lg bg-slate-900 text-slate-100 border border-slate-800 font-mono text-xs shadow-inner"
    >
        <div
            class="flex items-center justify-between border-b border-slate-800 pb-2 mb-2.5 text-slate-400"
        >
            <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-slate-700"></span>
                <span class="w-2 h-2 rounded-full bg-slate-700"></span>
                <span class="w-2 h-2 rounded-full bg-slate-700"></span>
                <span class="ml-1.5 text-slate-400 text-[11px]"
                    >sec_analysis.log</span
                >
            </div>
            <span id="log-step-tag" class="text-slate-400 text-[10px]"
                >EN ATTENTE</span
            >
        </div>
        <p
            id="log-output"
            class="text-slate-200 min-h-[2.5rem] flex items-center text-[15px] transition-opacity duration-200"
        >
            Sélectionnez une étape pour analyser le flux d'attaque.
        </p>
    </div>
</div>

<style>
    .node-card {
        padding: 1rem;
        border-radius: 0.5rem;
        border-width: 1px;
        transition: all 0.2s ease;
    }

    .step-btn {
        padding: 0.5rem 0.75rem;
        background-color: rgb(248, 250, 252);
        border: 1px solid rgb(226, 232, 240);
        color: rgb(71, 85, 105);
        font-size: 0.75rem;
        font-family:
            ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        border-radius: 0.375rem;
        transition: all 0.15s ease;
        text-align: left;
        font-weight: 500;
        cursor: pointer;
    }

    .step-btn:first-child:not(.active) {
        animation: guide-pulse 1.8s ease-in-out infinite;
    }

    .step-btn:hover {
        background-color: rgb(241, 245, 249);
        color: rgb(15, 23, 42);
        border-color: rgb(203, 213, 225);
    }

    .step-btn.active {
        background-color: rgba(37, 99, 235, 0.08);
        border-color: rgba(37, 99, 235, 0.3);
        color: rgb(29, 78, 216);
    }

    @keyframes guide-pulse {
        0%,
        100% {
            box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.18);
        }
        50% {
            box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.08);
        }
    }

    .line-active {
        stroke: rgb(217, 119, 6) !important;
        stroke-dasharray: 12 8;
        animation: flow-right 1s linear infinite;
    }

    .line-danger-reverse {
        stroke: rgb(225, 29, 72) !important;
        stroke-dasharray: 12 8;
        animation: flow-left 0.6s linear infinite;
    }

    .line-bypassed {
        stroke: rgb(203, 213, 225) !important; /* Grisé (slate-300) */
        stroke-dasharray: 6 6;
        opacity: 0.5;
    }

    @keyframes flow-right {
        to {
            stroke-dashoffset: -20;
        }
    }

    @keyframes flow-left {
        to {
            stroke-dashoffset: 20;
        }
    }
</style>

<script>
    interface StepData {
        id: number;
        badge: string;
        tag: string;
        log: string;
        carText: string;
        carBadgeStyle: string;
        lineCarAttacker: string;
        lineAttackerServer: string;
        carIconStyle: string;
        attackerSub: string;
        attackerCardStyle: string;
        serverCardStyle: string;
        serverSub: string;
        serverTitle: string;
    }

    const steps: StepData[] = [
        {
            id: 1,
            badge: "Étape 1/4",
            tag: "01_REQUEST",
            log: "> [REQUÊTE INITIALE] Le véhicule initie une connexion vers les services connectés distants.",
            carText: "Verrouillé",
            carBadgeStyle: "bg-green-100 text-slate-600 border-slate-200",
            lineCarAttacker: "line-active",
            lineAttackerServer: "line-active",
            carIconStyle: "bg-green-100 border-slate-200 text-slate-600",
            attackerSub: "Proxy intermédiaire",
            attackerCardStyle: "border-slate-200 bg-white",
            serverCardStyle: "border-slate-200 bg-white",
            serverSub: "Destination initiale",
            serverTitle: "Serveur BMW Légitime",
        },
        {
            id: 2,
            badge: "Étape 2/4",
            tag: "02_MITM_CERT",
            log: "> [INTERCEPTION] L'attaquant intercepte la requête et présente un faux certificat HTTPS. Le véhicule accepte la liaison sans broncher.",
            carText: "Piégé (MitM)",
            carBadgeStyle: "bg-amber-50 text-amber-700 border-amber-200",
            lineCarAttacker: "line-active",
            lineAttackerServer: "line-bypassed",
            carIconStyle: "bg-amber-50 border-amber-200 text-amber-600",
            attackerSub: "Faux certificat HTTPS actif",
            attackerCardStyle: "border-amber-300 bg-amber-50/40 shadow-sm",
            serverCardStyle: "border-rose-200 bg-rose-50/40 opacity-70",
            serverSub: "Chemin coupé",
            serverTitle: "Serveur BMW Légitime",
        },
        {
            id: 3,
            badge: "Étape 3/4",
            tag: "03_BYPASS",
            log: "> [CHEMIN CONTOURNÉ] Le lien vers le vrai serveur est totalement court-circuité. Le véhicule est piégé sur le faux serveur de l'attaquant.",
            carText: "Coupé du cloud officiel",
            carBadgeStyle: "bg-amber-50 text-amber-700 border-amber-200",
            lineCarAttacker: "",
            lineAttackerServer: "line-bypassed",
            carIconStyle: "bg-amber-50 border-amber-200 text-amber-600",
            attackerSub: "Imitation serveur officielle",
            attackerCardStyle: "border-slate-200 bg-white",
            serverCardStyle:
                "border-rose-200 bg-rose-50/30 opacity-40 grayscale",
            serverSub: "Injoignable",
            serverTitle: "Serveur BMW Légitime",
        },
        {
            id: 4,
            badge: "Étape 4/4",
            tag: "04_INJECTION",
            log: "> [COMMANDE INJECTÉE] L'attaquant pousse la commande \"DÉVERROUILLER\". Le véhicule croit recevoir l'ordre du vrai serveur et s'ouvre.",
            carText: "Déverrouillé !",
            carBadgeStyle:
                "bg-rose-50 text-rose-700 border-rose-200 font-semibold",
            lineCarAttacker: "line-danger-reverse",

            carIconStyle: "bg-rose-50 border-rose-200 text-rose-600",
            attackerSub: "Envoi payload malveillant",
            attackerCardStyle: "border-rose-300 bg-rose-50/40 shadow-sm",
            serverCardStyle:
                "border-rose-200 bg-rose-50/30 opacity-40 grayscale",
            serverSub: "Injoignable",
            serverTitle: "Serveur BMW Légitime",
        },
    ];

    let currentStep = 0;

    const buttons = document.querySelectorAll<HTMLButtonElement>(".step-btn");
    const logOutput = document.getElementById("log-output");
    const logStepTag = document.getElementById("log-step-tag");
    const carState = document.getElementById("car-state");
    const carIconContainer = document.getElementById("car-icon-container");
    const lineCarAttacker = document.getElementById("line-car-attacker");
    const lineAttackerServer = document.getElementById("line-attacker-server");
    const attackerSub = document.getElementById("attacker-subtext");
    const attackerCard = document.getElementById("node-attacker-card");
    const serverCard = document.getElementById("node-server-card");
    const serverSub = document.getElementById("server-subtext");
    const serverTitle = document.getElementById("server-title");

    function setStep(stepNumber: number) {
        currentStep = stepNumber;
        const data = steps.find((s) => s.id === stepNumber);
        if (!data) return;

        buttons.forEach((btn) => {
            const active = btn.getAttribute("data-step") === String(stepNumber);
            btn.classList.toggle("active", active);
        });

        if (logOutput) {
            logOutput.style.opacity = "0";
            setTimeout(() => {
                logOutput.textContent = data.log;
                logOutput.style.opacity = "1";
            }, 100);
        }

        if (logStepTag) logStepTag.textContent = data.tag;
        if (carState) {
            carState.textContent = data.carText;
            carState.className = `inline-block mt-2 px-2 py-0.5 rounded text-[11px] font-mono border transition-all ${data.carBadgeStyle}`;
        }

        if (carIconContainer) {
            carIconContainer.className = `w-12 h-12 mx-auto mb-3 rounded-lg border flex items-center justify-center transition-all duration-300 ${data.carIconStyle}`;
        }

        if (attackerSub) attackerSub.textContent = data.attackerSub;
        if (attackerCard)
            attackerCard.className = `node-card transition-all ${data.attackerCardStyle}`;
        if (serverCard)
            serverCard.className = `node-card transition-all ${data.serverCardStyle}`;
        if (serverSub) serverSub.textContent = data.serverSub;
        if (serverTitle) serverTitle.textContent = data.serverTitle;

        if (lineCarAttacker)
            lineCarAttacker.setAttribute(
                "class",
                `transition-all duration-300 ${data.lineCarAttacker}`,
            );
        if (lineAttackerServer)
            lineAttackerServer.setAttribute(
                "class",
                `transition-all duration-300 ${data.lineAttackerServer}`,
            );
    }

    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const step = Number(btn.getAttribute("data-step"));
            setStep(step);
        });
    });
</script>
