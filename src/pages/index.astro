---
import Layout from "../layouts/Layout.astro";
import AttackDiagram from "../components/AttackDiagram.astro";
import FlipCardGrid from "../components/FlipCardGrid.astro";
import type { FlipCard } from "../components/FlipCardGrid.astro";

const toyotaCards: FlipCard[] = [
	{
		type: "glossaire",
		front: "Bus CAN",
		back: "Le réseau électronique interne qui relie les composants d'une voiture entre eux (moteur, phares, portières...) et leur permet de communiquer.",
	},
	{
		type: "glossaire",
		front: "Injection (CAN injection)",
		back: "Le fait d'envoyer un faux message sur ce réseau pour faire croire aux autres composants qu'il est légitime.",
	},
	{
		type: "glossaire",
		front: "Immobiliseur",
		back: "Le système qui empêche normalement le moteur de démarrer sans la vraie clé.",
	},
	{
		type: "glossaire",
		front: "Authentification",
		back: "La vérification qu'un message provient bien de l'expéditeur qu'il prétend être — absente sur le bus CAN classique, ce qui rend l'injection possible.",
	},
	{
		type: "etape",
		step: 1,
		front: "Étape 1",
		back: "Le voleur débranche le câblage derrière le phare pour atteindre le bus CAN.",
	},
	{
		type: "etape",
		step: 2,
		front: "Étape 2",
		back: "Un petit boîtier, parfois déguisé en enceinte Bluetooth, est branché sur ce connecteur.",
	},
	{
		type: "etape",
		step: 3,
		front: "Étape 3",
		back: "L'appareil envoie un faux message qui imite celui d'une clé légitime.",
	},
	{
		type: "etape",
		step: 4,
		front: "Étape 4",
		back: "L'immobiliseur accepte le message et désactive la protection du véhicule.",
	},
	{
		type: "etape",
		step: 5,
		front: "Étape 5",
		back: "Le moteur démarre, sans qu'aucune vraie clé n'ait été utilisée.",
	},
];
import NuageMots from "../components/NuageMots.astro";
import Starlink from "../components/Starlink.astro";
import Quiz from "../components/Quiz.astro";
import carImg from "../assets/car.png";
import houseImg from "../assets/house.png";
import CanadaFlag from "../assets/canada.svg";
import USAFlag from "../assets/usa.svg";
import JapanFlag from "../assets/japan.svg";
import RollsRoyceLogo from "../assets/image14.svg";
import MiniLogo from "../assets/image15.svg";
import BMWLogo from "../assets/image16.svg";
---

<Layout>
	<div
		class="w-full min-h-screen bg-[#effbfe] text-[#071a27] font-sans antialiased"
	>
		<main
			class="max-w-280 mx-auto pt-[54px] pr-[92px] pb-[160px] pl-[30px] [@media(max-width:768px)]:p-4 [@media(max-width:768px)]:pb-[90px]"
		>
			<!-- HERO / INTRODUCTION -->
			<section class="max-w-[970px] scroll-mt-7" id="introduction">
				<div
					class="mb-[7px] text-[#079bcf] text-[12px] font-bold tracking-[0.14em] uppercase"
				>
					Parcours d’acculturation à la cybersécurité
				</div>
				<h1
					class="mb-[11px] text-[#071923] text-[clamp(38px,5vw,66px)] leading-[0.96] tracking-[-0.065em] font-bold"
				>
					Introduction
				</h1>
				<p
					class="max-w-[900px] text-[#39505b] text-[20px] leading-[1.68] m-0"
				>
					Les enjeux de la cybersécurité sont aujourd’hui partout :
					dans nos usages, nos outils et les services que nous
					utilisons chaque jour. Ce parcours propose une lecture
					simple et concrète de situations réelles pour mieux
					reconnaître les risques, adopter les bons réflexes et
					protéger les données qui comptent.
				</p>

				<figure
					class="w-full max-w-[915px] my-[28px] mx-0 mb-[100px] py-[28px] px-[33px] pb-[16px] rounded-[14px] bg-[rgba(255,255,255,0.84)] border border-[rgba(157,210,225,0.6)] shadow-[0_17px_32px_rgba(79,156,178,0.12),0_2px_7px_rgba(62,123,141,0.08)]"
				>
					<div
						class="overflow-hidden aspect-[16/8.5] bg-[#061521] border-[8px] border-[#09121a] shadow-[0_4px_0_rgba(2,13,21,0.35)]"
					>
						<video
							class="block w-full h-full object-cover"
							src="https://api.preview.4hfactory.tech/storage/companies/2_6BZLRA9PU5/1486_XB5J2PAIOL/7320_19GEQTXSKH.webm"
							controls
							playsinline
							preload="metadata"
							aria-label="Vidéo d’introduction au parcours"
						></video>
					</div>
					<figcaption
						class="mt-3 text-[#7d969f] text-[9px] text-center"
					>
						Regarder la vidéo d’introduction
					</figcaption>
				</figure>
			</section>

			<!-- CAS 1 -->
			<section class="max-w-247.5 mb-29 scroll-mt-7" id="cas-1">
				<div class="flex mb-2 gap-7 align-items-bottom flex-column">
					<h2
						class="m-0 text-[#081924] text-[clamp(25px,3vw,44px)] leading-[1.1] tracking-[-0.052em] font-bold"
					>
						01 - STARLINK <em class="text-[#1b70d3] not-italic"
							>Subaru</em
						>
					</h2>
					<p
						class="text-[#08a1d4] text-[18px] font-(Segoe UI) font-bold tracking-[0.13em] uppercase border-2 border-[#08a1d4] rounded-[50px] pt-1 pb-1 pl-2 pr-2 text-center"
					>
						2025
					</p>
				</div>

				<p
					class="max-w-[900px] mb-[10px] text-[#46606b] text-[18px] leading-[1.65] m-0"
				>
					Dans ce premier cas, nous allons observer comment un service
					connecté peut exposer des informations sensibles. En
					comprenant le chemin parcouru par une donnée, il devient
					plus facile d’identifier les points de vigilance et de
					limiter la surface d’exposition.
				</p>
				<p class="mb-4 text-[#0879ae] text-[17px] font-bold">
					Entrez dans la peau de l’attaquant : lancez la simulation et
					observez ce qui se passe.
				</p>

				<Starlink />

				<!-- GRILLE DES STATS ET VIDÉO -->
				<div
					class="grid grid-cols-2 gap-6 mt-8 [@media(max-width:768px)]:grid-cols-1"
				>
					<div class="flex flex-col gap-5">
						<!-- BLOC LOCALISATION -->
						<div
							class="bg-white rounded-[20px] p-5 shadow-[0_10px_25px_rgba(11,40,80,0.05)]"
						>
							<div class="flex items-baseline gap-[10px] mb-3">
								<strong
									class="text-[32px] font-extrabold text-[#2a6cf5] leading-none"
									>5</strong
								>
								<span
									class="text-[14px] font-extrabold text-black tracking-[0.08em]"
									>MÈTRES DE LOCALISATION PRÉCISE</span
								>
							</div>
							<div
								class="flex items-center justify-between pt-[10px] px-[10px] pb-0"
							>
								<img
									src={carImg.src}
									alt="Subaru bleue"
									class="h-[45px] w-auto object-contain"
								/>
								<div
									class="flex-1 h-[0.5px] bg-[#4182f7] mx-4 relative before:content-[''] before:absolute before:-top-[3px] before:left-0 before:border-solid before:border-y-transparent before:border-r-[#4182f7] before:border-y-[4px] before:border-r-[6px] before:border-l-0 after:content-[''] after:absolute after:-top-[3px] after:right-0 after:border-solid after:border-y-transparent after:border-l-[#4182f7] after:border-y-[4px] after:border-l-[6px] after:border-r-0"
								>
								</div>
								<img
									src={houseImg.src}
									alt="Maison"
									class="h-[60px] w-auto object-contain"
								/>
							</div>
						</div>

						<!-- SOUS-GRILLE 2 CARTE -->
						<div
							class="grid grid-cols-2 gap-5 [@media(max-width:768px)]:grid-cols-1"
						>
							<div
								class="bg-white rounded-[20px] p-5 shadow-[0_10px_25px_rgba(11,40,80,0.05)] flex flex-col justify-between"
							>
								<div
									class="flex items-baseline gap-[10px] mb-3"
								>
									<strong
										class="text-[32px] font-extrabold text-[#2a6cf5] leading-none"
										>3</strong
									>
									<span
										class="text-[14px] font-extrabold text-black tracking-[0.08em]"
										>PAYS CONCERNÉS</span
									>
								</div>
								<div
									class="flex items-end justify-between gap-2 mt-3"
								>
									<div
										class="flex flex-col items-center gap-[6px]"
									>
										<img
											src={CanadaFlag.src}
											alt="Canada"
											class="w-8 h-auto object-cover rounded-[2px] shadow-[0_1px_3px_rgba(0,0,0,0.15)]"
										/>
										<span
											class="text-[12px] font-extrabold text-[#2a6cf5]"
											>CANADA</span
										>
									</div>
									<div
										class="flex flex-col items-center gap-[6px]"
									>
										<img
											src={USAFlag.src}
											alt="États-Unis"
											class="w-8 h-auto object-cover rounded-[2px] shadow-[0_1px_3px_rgba(0,0,0,0.15)]"
										/>
										<span
											class="text-[12px] font-extrabold text-[#2a6cf5]"
											>ETATS-UNIS</span
										>
									</div>
									<div
										class="flex flex-col items-center gap-[6px]"
									>
										<img
											src={JapanFlag.src}
											alt="Japon"
											class="w-8 h-auto object-cover rounded-[2px] shadow-[0_1px_3px_rgba(0,0,0,0.15)]"
										/>
										<span
											class="text-[12px] font-extrabold text-[#2a6cf5]"
											>JAPON</span
										>
									</div>
								</div>
							</div>

							<div
								class="bg-white rounded-[20px] p-5 shadow-[0_10px_25px_rgba(11,40,80,0.05)] flex flex-col justify-between"
							>
								<div
									class="flex items-baseline gap-[10px] mb-3"
								>
									<strong
										class="text-[32px] font-extrabold text-[#2a6cf5] leading-none"
										>4</strong
									>
									<span
										class="text-[14px] font-extrabold text-black tracking-[0.08em]"
										>INFORMATIONS POUR ENTRER</span
									>
								</div>
								<div
									class="w-auto justify-center text-blue-600 text-[11px] font-extrabold font-['Inter'] uppercase"
								>
									nom + code postal, email, ou plaque
									d'immatriculation
								</div>
							</div>
						</div>
					</div>

					<!-- CARTE VIDÉO DEMO -->
					<div
						class="bg-white rounded-[20px] p-4 shadow-[0_10px_25px_rgba(11,40,80,0.05)] flex flex-col justify-between"
					>
						<div
							class="w-full aspect-[16/9] rounded-xl overflow-hidden bg-black"
						>
							<iframe
								class="w-full h-full border-0"
								src="https://www.youtube.com/embed/0i8juy6RPBI?si=LSWO_fELUqUtbnr9"
								title="Démo Subaru"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
								allowfullscreen></iframe>
						</div>
						<figcaption
							class="mt-[14px] text-[14px] text-[#7288a2] text-center leading-[1.4]"
						>
							Prise de contrôle d’une Subaru en utilisant la
							plaque d’immatriculation en environ 10 secondes
						</figcaption>
					</div>
				</div>
			</section>

			<!-- CAS 2 -->
			<section class="max-w-[990px] mb-[116px] scroll-mt-7" id="cas-2">
				<div class="flex mb-2 gap-7 flex-column">
					<h2
						class="m-0 text-[#081924] text-[clamp(25px,3vw,44px)] leading-[1.1] tracking-[-0.052em] font-bold"
					>
						02 - HOMME DU MILIEU <em
							class="text-[#1b70d3] not-italic">BMW</em
						>
					</h2>
					<p
						class="text-[#08a1d4] text-[15px] font-(Segoe UI) font-bold tracking-[0.13em] uppercase mb-5 border-2 border-[#08a1d4] rounded-[50px] px-2 py-1 inline-block"
					>
						2015
					</p>
				</div>
				<p
					class="max-w-[900px] mb-[10px] text-[#46606b] text-[18px] leading-[1.65] m-0"
				>
					Deux chercheurs en sécurité ont découvert une faille dans le
					service connecté d’un constructeur automobile. Cette
					démonstration permet de comprendre comment une
					fonctionnalité pratique peut devenir un vecteur d’exposition
					lorsqu’elle n’est pas suffisamment protégée.
				</p>
				<p class="mb-4 text-[#0879ae] text-[17px] font-bold">
					Explorez le scénario puis retenez une idée essentielle : une
					donnée utile doit aussi rester maîtrisée.
				</p>

				<AttackDiagram />

				<!-- BLOCS MÉTRIQUES CAS 2 -->
				<div
					class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-[960px] mx-auto mt-10"
				>
					<div
						class="min-h-[150px] flex flex-col items-center justify-center p-6 rounded-[20px] bg-white border border-[rgba(157,210,225,0.6)] shadow-[0_17px_32px_rgba(79,156,178,0.12),0_2px_7px_rgba(62,123,141,0.08)] text-center transition-transform"
					>
						<strong
							id="vehicle-counter"
							class="text-[#3680d7] text-[42px] font-extrabold leading-none"
							data-target="2200000">0</strong
						>
						<span
							class="mt-2 text-[#1768b8] text-[17px] font-extrabold"
							>de véhicules concernés</span
						>
					</div>

					<div
						class="min-h-[150px] flex flex-col items-center justify-center p-6 rounded-[20px] bg-white border border-[rgba(157,210,225,0.6)] shadow-[0_17px_32px_rgba(79,156,178,0.12),0_2px_7px_rgba(62,123,141,0.08)] text-center transition-transform"
					>
						<span
							class="text-[#3680d7] text-[18px] font-extrabold tracking-[0.05em] mb-4 uppercase"
							>3 marques concernées</span
						>
						<div
							class="flex justify-center items-center justify-between gap-6"
						>
							<img
								src={RollsRoyceLogo.src}
								alt="Rolls-Royce"
								class="h-13 w-auto object-contain drop-shadow-[0_1px_2px_rgba(0,0,0,0.15)]"
							/>
							<img
								src={MiniLogo.src}
								alt="MINI"
								class="h-13 w-auto object-contain drop-shadow-[0_1px_2px_rgba(0,0,0,0.15)]"
							/>
							<img
								src={BMWLogo.src}
								alt="BMW"
								class="h-13 w-auto object-contain drop-shadow-[0_1px_2px_rgba(0,0,0,0.15)]"
							/>
						</div>
					</div>

					<div
						class="min-h-[150px] flex flex-col items-center justify-center p-6 rounded-[20px] bg-white border border-[rgba(157,210,225,0.6)] shadow-[0_17px_32px_rgba(79,156,178,0.12),0_2px_7px_rgba(62,123,141,0.08)] text-center transition-transform"
					>
						<strong
							id="hack-time-counter"
							class="text-[#d75f36] text-[42px] font-extrabold leading-none"
							data-target="10">0</strong
						>
						<span
							class="mt-2 text-[#b84f17] text-[17px] font-extrabold"
							>minutes environ pour déverrouiller</span
						>
					</div>
				</div>
			</section>

			<!-- CAS 3 -->
			<section class="max-w-[990px] mb-[130px] scroll-mt-7" id="cas-3">
				<div class="flex mb-2 gap-7 flex-column">
					<h2
						class="m-0 text-[#081924] text-[clamp(25px,3vw,44px)] leading-[1.1] tracking-[-0.052em] font-bold"
					>
						03 - CLONAGE DE CLÉ <em
							class="text-[#1b70d3] not-italic">Tesla Model S</em
						>
					</h2>
					<p
						class="text-[#08a1d4] text-[15px] font-(Segoe UI) font-bold tracking-[0.13em] uppercase mb-5 border-2 border-[#08a1d4] rounded-[50px] px-2 py-1 inline-block"
					>
						2018
					</p>
				</div>
				<p
					class="max-w-[900px] mb-[10px] text-[#46606b] text-[18px] leading-[1.65] m-0"
				>
					En 2018, des chercheurs belges ont mis en évidence une
					faiblesse permettant de cloner une clé de véhicule.
					L’exemple rappelle qu’un objet physique peut aussi être une
					interface numérique : la sécurité dépend autant du protocole
					que de l’usage qui en est fait.
				</p>
				<p class="mb-4 text-[#0879ae] text-[17px] font-bold">
					Selon vous, combien de temps faut-il pour cloner une clé ?
					Faites votre choix.
				</p>

				<Quiz />
			</section>

			<!-- CAS 4 -->
			<section class="max-w-[990px] mb-[116px] scroll-mt-7" id="cas-4">
				<div class="flex mb-2 gap-7 flex-column">
					<h2
						class="m-0 text-[#081924] text-[clamp(25px,3vw,44px)] leading-[1.1] tracking-[-0.052em] font-bold"
					>
						04 - CAN VIA PHARE <em class="text-[#1b70d3] not-italic"
							>Toyota Lexus</em
						>
					</h2>
					<p
						class="text-[#08a1d4] text-[15px] font-(Segoe UI) font-bold tracking-[0.13em] uppercase mb-5 border-2 border-[#08a1d4] rounded-[50px] px-2 py-1 inline-block"
					>
						2023
					</p>
				</div>
				<p
					class="max-w-[900px] mb-[10px] text-[#46606b] text-[18px] leading-[1.65] m-0"
				>
					En 2023, un vol de véhicule a mis en lumière une méthode
					inédite : l’injection de messages sur le réseau CAN via le
					connecteur d’un phare. Cette attaque permet de contourner la
					protection antidémarrage et de déverrouiller les portes sans
					la clé.
				</p>
				<p class="mb-4 text-[#0879ae] text-[17px] font-bold">
					Observez les différentes étapes de l’attaque ci-dessous.
				</p>

				<FlipCardGrid cards={toyotaCards} />
			</section>

			<!-- SYNTHÈSE -->
			<section
				class="[@media(max-width:768px)]:p-4 [@media(max-width:768px)]:pb-[90px] py-7 border-t border-[#b8e5f1] scroll-mt-7"
				id="synthese"
				aria-labelledby="synthesis-title"
			>
				<span
					class="text-[#08a1d4] text-[12px] font-extrabold tracking-[0.13em] uppercase"
					>À retenir</span
				>
				<h2
					id="synthesis-title"
					class="my-3 text-[#081924] text-[clamp(25px,3vw,44px)] leading-[1.1] tracking-[-0.052em] font-bold"
				>
					La sécurité commence par la curiosité.
				</h2>
				<p
					class="text-[#46606b] text-[18px] leading-[1.6] m-0 [@media(max-width:768px)]:p-4 [@media(max-width:768px)]:pb-[90px]"
				>
					Chaque scénario nous invite à regarder autrement les objets
					et services qui nous entourent. Une question posée au bon
					moment peut empêcher qu’une information sorte de son cadre.
				</p>
			</section>
			<NuageMots />
		</main>
	</div>
</Layout>

<style>
	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(15px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

<script>
	// Gestion des compteurs du Cas 2
	document.addEventListener("DOMContentLoaded", () => {
		const el = document.getElementById("vehicle-counter");
		if (el) {
			const target = parseInt(el.dataset.target, 10);
			let hasStarted = false;

			const formatNumber = (n) =>
				n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ");

			const startCounter = () => {
				const duration = 2000;
				const start = 0;
				const startTime = performance.now();

				const animate = (now) => {
					const progress = Math.min((now - startTime) / duration, 1);
					const current = Math.floor(
						start + (target - start) * progress,
					);
					el.textContent = formatNumber(current);

					if (progress < 1) {
						requestAnimationFrame(animate);
					} else {
						el.textContent = formatNumber(target);
					}
				};

				requestAnimationFrame(animate);
			};

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting && !hasStarted) {
							hasStarted = true;
							startCounter();
							observer.disconnect();
						}
					});
				},
				{ threshold: 0.3 },
			);

			observer.observe(el);
		}
	});

	document.addEventListener("DOMContentLoaded", () => {
		const el = document.getElementById("hack-time-counter");
		if (el) {
			const target = parseInt(el.dataset.target, 10);
			let hasStarted = false;

			const startCounter = () => {
				const duration = 2000;
				const start = 0;
				const startTime = performance.now();

				const animate = (now) => {
					const progress = Math.min((now - startTime) / duration, 1);
					const current = Math.floor(
						start + (target - start) * progress,
					);
					el.textContent = current;

					if (progress < 1) {
						requestAnimationFrame(animate);
					} else {
						el.textContent = target;
					}
				};

				requestAnimationFrame(animate);
			};

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting && !hasStarted) {
							hasStarted = true;
							startCounter();
							observer.disconnect();
						}
					});
				},
				{ threshold: 0.3 },
			);

			observer.observe(el);
		}
	});

</script>
